# --- Core ------------------------------------------------------------------
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/excel_connect_hub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

# Behind a proxy (Render, Fly, nginx). Number of hops to trust, or "true".
# TRUST_PROXY=1

# --- Database (managed Postgres, e.g. Supabase) -----------------------------
# Turn TLS on for any hosted database. Paste the provider's CA certificate
# (PEM, newlines as \n) into DB_SSL_CA to also verify the server's identity;
# without it the connection is encrypted but the server is not verified.
# DB_SSL=true
# DB_SSL_CA=
# Keep the pool small: hosted poolers cap connections per project.
# DB_POOL_MAX=10
# Supabase only: `npm run db:migrate` then enables row-level security on every
# table, which closes Supabase's public REST Data API. The app is unaffected
# because it connects as the table owner. Do NOT set this if the app connects as
# a different, non-owner role.
# DB_RLS=true

# --- Email -----------------------------------------------------------------
# With none of these set, every message is printed to the server console, so
# verification codes and reset links still work in development. Set all four to
# send real email; the credentials are checked once at boot and a failure is
# reported there rather than on the first user's registration.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM=Excel Connect Hub <no-reply@yourdomain.com>

# --- Operations ------------------------------------------------------------
# Who is emailed when something needs a human (a payment that does not match what
# was charged, a bad payment-webhook signature, repeated server errors, a crash).
# Comma-separated. If empty, every active admin with a verified email is told.
# At most one email per kind of problem per 15 minutes.
# ALERT_EMAILS=ops@yourdomain.com,founder@yourdomain.com
#
# Error reporting to Sentry. Does nothing unless SENTRY_DSN is set. Reports carry
# the error and stack only: no headers, cookies, request bodies or user details.
# SENTRY_DSN=
# SENTRY_RELEASE=
#
# Logins last 24 hours and renew themselves while the person is active.
# JWT_EXPIRES_IN=24h

# --- Rate limiting ---------------------------------------------------------
# Without this the counters live in the process: a restart clears them, and
# behind more than one instance each gets its own full budget. Set it in
# production so every instance shares one set of counters.
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=ech:rl:

# --- Uploads ---------------------------------------------------------------
# Minutes an unreferenced upload is kept before `npm run uploads:prune` will
# remove it. The grace period protects a file that was just uploaded into a form
# the user has not submitted yet.
# UPLOAD_GRACE_MINUTES=120

# Absolute origin used to build upload URLs. Set this when the API is behind a
# proxy that terminates TLS, so links are https and point at the public host.
# PUBLIC_API_ORIGIN=https://api.yourdomain.com

# --- Payments ----------------------------------------------------------------
# The platform is free until this is turned on. With PAYMENTS_ENABLED unset,
# plans are visible but checkout is refused with "coming soon", and no gateway
# credentials are needed.
#
# A gateway is a driver (src/payments). PAYMENT_PROVIDER selects it:
#   mock         development only; moves no money; refused in production
#   flutterwave  complete, but merchant accounts are not available in every
#                country (not in Tanzania for this project)
#   (selcom and clickpesa are planned; add the driver, then list it here)
# Unset means "mock". PAYMENTS_ENABLED=true is refused at boot unless a real
# provider is chosen and ALL of its variables below are set.
# PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=flutterwave
# FLW_PUBLIC_KEY=
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=
